@model WebConsultasMedicas.Models.MedicoIndicacionViewModel

@{
    var c = Model.Cita;
    ViewData["Title"] = $"Cita #{Model.IdCita}";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">Cita #@Model.IdCita</h2>
        @if (c is not null)
        {
            <p class="text-muted mb-0">
                @($"{c.FechaCita:yyyy-MM-dd} {c.HoraCita:hh\\:mm} / {c.Paciente?.ApellidoPaterno} {c.Paciente?.ApellidoMaterno}, {c.Paciente?.Nombres}")
            </p>
        }
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="MisCitas">Volver</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Atender" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdCita" />
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>

            <div class="col-md-4">
                <label asp-for="IdEstadoCita" class="form-label">Estado</label>
                <select asp-for="IdEstadoCita" class="form-select" asp-items="Model.Estados"></select>
                <span asp-validation-for="IdEstadoCita" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Observacion" class="form-label">Indicaciones / Observación</label>
                <textarea asp-for="Observacion" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Observacion" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="MisCitas" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
